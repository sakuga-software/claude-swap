{
  "name": "@sakuga-software/claude-swap",
  "version": "0.27.0-beta.1",
  "description": "Multi-account switcher for Claude Code (TypeScript port)",
  "license": "MIT",
  "author": "Sakuga Software",
  "contributors": [
    "Onur Cetinkol <onurcetinkol@gmail.com> (author of the original Python claude-swap)"
  ],
  "homepage": "https://github.com/sakuga-software/claude-swap/tree/main/ts#readme",
  "bugs": "https://github.com/sakuga-software/claude-swap/issues",
  "keywords": [
    "claude",
    "claude-code",
    "account-switcher",
    "cli"
  ],
  "type": "module",
  "bin": {
    "cswap": "dist/cli.js",
    "claude-swap": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "upstream:status": "tsx scripts/upstream-status.ts",
    "upstream:mark": "tsx scripts/upstream-mark.ts",
    "prepack": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakuga-software/claude-swap.git",
    "directory": "ts"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
